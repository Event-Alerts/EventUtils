{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["Event Alerts", "aabss", "srnyx", "pvty", "QWERTZ_EXE"],
  "contact": {
    "repo": "https://github.com/Event-Alerts/EventUtils",
    "discord": "https://discord.gg/uFPFNYzAWC"
  },
  "license": "MIT",
  "icon": "assets/eventutils/textures/icon.png",
  "environment": "client",
  "mixins": [
    "${mixins}"
  ],
  "entrypoints": {
    "client": [
      "${group}.eventutils.EventUtils"
    ],
    "modmenu":  [
      "${group}.eventutils.ModMenuImpl"
    ]
  },
  "depends": {
    "minecraft": ">=${deps_minecraft}",
    "fabricloader": ">=${deps_loader}",
    "fabric": ">=${deps_fabric_api}",
    "yet_another_config_lib_v3": ">=${deps_yacl}"
  },
  "suggests": {
    "modmenu": ">=${deps_modmenu}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/uFPFNYzAWC",
        "modmenu.source": "https://github.com/Event-Alerts/EventUtils"
      }
    }
  }
}
